# Copy to .env to override the docker compose defaults. Every value below is the default.

# PostgreSQL credentials (same user for the three databases: patients, scheduling, notifications)
POSTGRES_USER=medirdv
POSTGRES_PASSWORD=medirdv

# Keycloak bootstrap admin (console: http://localhost:8280/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Public URL of Keycloak as seen by browsers. It is the token issuer checked by every service,
# and the URL written to the web app's /config.json.
KEYCLOAK_EXTERNAL_URL=http://localhost:8280
# Public URL of the web app, added to the realm's redirect URIs / web origins at import
MEDIRDV_PUBLIC_URL=http://localhost:8204

# Booking saga: PENDING_VALIDATION appointments older than this are rejected (ISO-8601 duration)
SAGA_VALIDATION_TIMEOUT=PT2M

# Send traces to Tempo (use with: docker compose --profile observability up -d)
TRACING_EXPORT_ENABLED=false

# Grafana admin (http://localhost:3200)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Variables read by the Spring Boot services (set by docker-compose.yml / Helm,
# defaults in each application.yml target the host ports for local `mvn spring-boot:run`):
#   SERVER_PORT, MANAGEMENT_PORT (actuator, 9200-9203), DB_URL, DB_USER, DB_PASSWORD,
#   SPRING_PROFILES_ACTIVE=demo (loads the demo data set), FLYWAY_LOCATIONS,
#   KAFKA_BOOTSTRAP_SERVERS, MEDIRDV_KAFKA_PARTITIONS (3), MEDIRDV_KAFKA_REPLICAS (1), JWT_ISSUER_URI, JWT_JWK_SET_URI, OTLP_TRACING_ENDPOINT,
#   TRACING_EXPORT_ENABLED, LOGGING_STRUCTURED_FORMAT_CONSOLE (ecs = JSON logs),
#   web image: KEYCLOAK_URL, KEYCLOAK_REALM, KEYCLOAK_CLIENT_ID, API_URL (written to /config.json)
#   gateway only: PATIENT_SERVICE_URL, SCHEDULING_SERVICE_URL, NOTIFICATION_SERVICE_URL, CORS_ALLOWED_ORIGINS
